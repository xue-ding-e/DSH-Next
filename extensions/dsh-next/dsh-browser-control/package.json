{
  "name": "dsh-browser-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "description": "Let the model drive the DSH Desktop sidebar browser: navigate, snapshot, click, fill, read, screenshot — reusing the cookie jar and login state the user already has in that tab.",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  }
}
